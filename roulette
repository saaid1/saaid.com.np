<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fat Dog Roulette</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      background: #0f172a;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: #f8fafc;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px 12px;
    }

    h1 {
      margin-bottom: 24px;
      font-size: 1.8rem;
      letter-spacing: -0.02em;
      text-align: center;
    }

    .roulette-arena {
      display: flex;
      flex-wrap: wrap;
      gap: 36px;
      justify-content: center;
      align-items: center;
      margin-bottom: 32px;
    }

    .roulette-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 440px;
    }

    .stage {
      position: relative;
      width: 420px;
      height: 420px;
      border-radius: 50%;
    }

    /* Fixed stopper pin at 12 o'clock */
    .stopper-pin {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 14px solid transparent;
      border-right: 14px solid transparent;
      border-top: 24px solid #ef4444;
      z-index: 20;
      filter: drop-shadow(0 3px 5px rgba(0,0,0,0.5));
    }

    canvas {
      display: block;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6), 0 0 0 6px #1e293b;
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
    }

    /* Collapse effect for the roulette canvas */
    canvas.collapsed {
      transform: scale(0);
      opacity: 0;
      pointer-events: none;
    }

    /* Winner Zoom-Out Overlay */
    .winner-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      overflow: hidden;
      border: 6px solid #38bdf8;
      box-shadow: 0 12px 30px rgba(0,0,0,0.7);
      background: #1e293b;
      opacity: 0;
      transform: scale(0.1);
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
      pointer-events: none;
      z-index: 10;
    }

    .winner-overlay.revealed {
      opacity: 1;
      transform: scale(1);
    }

    .winner-overlay img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Information block displayed below the circle */
    .winner-info {
      margin-top: 18px;
      text-align: center;
      min-height: 60px;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.5s ease 0.4s, transform 0.5s ease 0.4s;
    }

    .winner-info.revealed {
      opacity: 1;
      transform: translateY(0);
    }

    .winner-name {
      font-size: 1.4rem;
      font-weight: 700;
      color: #38bdf8;
    }

    .winner-area {
      font-size: 0.95rem;
      color: #94a3b8;
      margin-top: 4px;
    }

    button#spinBtn {
      padding: 14px 44px;
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #fff;
      background: #2563eb;
      border: none;
      border-radius: 9999px;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
      transition: background 0.2s, transform 0.1s;
    }

    button#spinBtn:hover:not(:disabled) {
      background: #1d4ed8;
      transform: translateY(-1px);
    }

    button#spinBtn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  </style>
</head>
<body>

  <h1>Fat Dog Double Roulette</h1>

  <div class="roulette-arena">
    <!-- Wheel 1 -->
    <div class="roulette-wrapper" id="wrapper-0">
      <div class="stage">
        <div class="stopper-pin"></div>
        <canvas id="wheel-0" width="840" height="840"></canvas>
        <div class="winner-overlay" id="overlay-0">
          <img id="overlay-img-0" src="" alt="Winner">
        </div>
      </div>
      <div class="winner-info" id="info-0">
        <div class="winner-name" id="name-0"></div>
        <div class="winner-area" id="area-0"></div>
      </div>
    </div>

    <!-- Wheel 2 -->
    <div class="roulette-wrapper" id="wrapper-1">
      <div class="stage">
        <div class="stopper-pin"></div>
        <canvas id="wheel-1" width="840" height="840"></canvas>
        <div class="winner-overlay" id="overlay-1">
          <img id="overlay-img-1" src="" alt="Winner">
        </div>
      </div>
      <div class="winner-info" id="info-1">
        <div class="winner-name" id="name-1"></div>
        <div class="winner-area" id="area-1"></div>
      </div>
    </div>
  </div>

  <button id="spinBtn" onclick="spinRoulettes()">Spin</button>

  <script>
    const DOG_DATASET = [
      { name: "Barnaby", area: "KTM - Patan", photo: "https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=400&q=80" },
      { name: "Waffles", area: "Delhi - Hauz Khas", photo: "https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=400&q=80" },
      { name: "Chunk", area: "KTM - Jhamsikhel", photo: "https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=400&q=80" },
      { name: "Meatball", area: "Delhi - Vasant Kunj", photo: "https://images.unsplash.com/photo-1537151625747-768eb6cf92b2?auto=format&fit=crop&w=400&q=80" },
      { name: "Mochi", area: "KTM - Lazimpat", photo: "https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?auto=format&fit=crop&w=400&q=80" },
      { name: "Buster", area: "Delhi - Saket", photo: "https://images.unsplash.com/photo-1561037404-61cd46aa615b?auto=format&fit=crop&w=400&q=80" },
      { name: "Pudge", area: "KTM - Thamel", photo: "https://images.unsplash.com/photo-1587300003388-59208cc962cb?auto=format&fit=crop&w=400&q=80" },
      { name: "Potato", area: "Delhi - Connaught Place", photo: "https://images.unsplash.com/photo-1530281700549-e82e7bf110d6?auto=format&fit=crop&w=400&q=80" },
      { name: "Gordo", area: "KTM - Sanepa", photo: "https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=400&q=80" },
      { name: "Tank", area: "Delhi - Defense Colony", photo: "https://images.unsplash.com/photo-1588943211346-0908a1fb0b01?auto=format&fit=crop&w=400&q=80" }
    ];

    const NUM_SECTORS = 10;
    const SECTOR_ANGLE = (2 * Math.PI) / NUM_SECTORS;
    const SECTOR_COLORS = [
      "#1e293b", "#334155", "#1e293b", "#334155", "#1e293b",
      "#334155", "#1e293b", "#334155", "#1e293b", "#334155"
    ];

    // Preload image objects for canvas clipping
    const loadedImages = [];
    let imagesReady = false;

    function preloadImages() {
      let counter = 0;
      DOG_DATASET.forEach((dog, idx) => {
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.src = dog.photo;
        img.onload = () => {
          counter++;
          if (counter === DOG_DATASET.length) {
            imagesReady = true;
            roulettes.forEach(r => r.draw());
          }
        };
        loadedImages[idx] = img;
      });
    }

    class Roulette {
      constructor(canvasId, index) {
        this.index = index;
        this.canvas = document.getElementById(canvasId);
        this.ctx = this.canvas.getContext("2d");
        this.overlay = document.getElementById(`overlay-${index}`);
        this.overlayImg = document.getElementById(`overlay-img-${index}`);
        this.infoBox = document.getElementById(`info-${index}`);
        this.nameEl = document.getElementById(`name-${index}`);
        this.areaEl = document.getElementById(`area-${index}`);
        this.angle = 0; // In radians
      }

      draw() {
        const ctx = this.ctx;
        const width = this.canvas.width;
        const height = this.canvas.height;
        const cx = width / 2;
        const cy = height / 2;
        const radius = cx;

        ctx.clearRect(0, 0, width, height);
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(this.angle);

        for (let i = 0; i < NUM_SECTORS; i++) {
          const startAngle = i * SECTOR_ANGLE;
          const endAngle = startAngle + SECTOR_ANGLE;

          // Draw sector slice
          ctx.beginPath();
          ctx.moveTo(0, 0);
          ctx.arc(0, 0, radius, startAngle, endAngle);
          ctx.fillStyle = SECTOR_COLORS[i % SECTOR_COLORS.length];
          ctx.fill();
          ctx.lineWidth = 2;
          ctx.strokeStyle = "#475569";
          ctx.stroke();

          // Render contents along sector bisector
          ctx.save();
          const midAngle = startAngle + SECTOR_ANGLE / 2;
          ctx.rotate(midAngle);

          // 1. Photo frame near outer circumference (wider edge)
          const photoCenterR = radius * 0.76;
          const photoRadius = radius * 0.14;

          ctx.save();
          ctx.beginPath();
          ctx.arc(photoCenterR, 0, photoRadius, 0, 2 * Math.PI);
          ctx.fillStyle = "#0f172a";
          ctx.fill();
          ctx.lineWidth = 6;
          ctx.strokeStyle = "#38bdf8";
          ctx.stroke();
          ctx.clip();

          if (imagesReady && loadedImages[i]) {
            ctx.drawImage(
              loadedImages[i],
              photoCenterR - photoRadius,
              -photoRadius,
              photoRadius * 2,
              photoRadius * 2
            );
          }
          ctx.restore();

          // 2. Name & Location between circular frame and center
          ctx.fillStyle = "#ffffff";
          ctx.font = "bold 24px system-ui, sans-serif";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText(DOG_DATASET[i].name, radius * 0.44, -12);

          ctx.fillStyle = "#94a3b8";
          ctx.font = "17px system-ui, sans-serif";
          ctx.fillText(DOG_DATASET[i].area, radius * 0.44, 18);

          ctx.restore();
        }

        // Center hub cap
        ctx.beginPath();
        ctx.arc(0, 0, radius * 0.16, 0, 2 * Math.PI);
        ctx.fillStyle = "#0f172a";
        ctx.fill();
        ctx.lineWidth = 6;
        ctx.strokeStyle = "#38bdf8";
        ctx.stroke();

        ctx.restore();
      }

      reset() {
        this.canvas.classList.remove("collapsed");
        this.overlay.classList.remove("revealed");
        this.infoBox.classList.remove("revealed");
      }

      // Calculate which slice aligns with 12 o'clock (top pointer = -PI / 2)
      getWinningDog() {
        const topAngle = -Math.PI / 2;
        // Current angle mod 2*PI normalized to [0, 2*PI)
        let normalized = (topAngle - (this.angle % (2 * Math.PI))) % (2 * Math.PI);
        if (normalized < 0) normalized += 2 * Math.PI;

        const winningIndex = Math.floor(normalized / SECTOR_ANGLE) % NUM_SECTORS;
        return DOG_DATASET[winningIndex];
      }

      collapseAndReveal(winner) {
        // Step 1: Collapse the wheel canvas
        this.canvas.classList.add("collapsed");

        // Step 2: Prepare overlay photo and text
        this.overlayImg.src = winner.photo;
        this.nameEl.textContent = winner.name;
        this.areaEl.textContent = winner.area;

        // Step 3: Trigger zoom-out expansion
        setTimeout(() => {
          this.overlay.classList.add("revealed");
          this.infoBox.classList.add("revealed");
        }, 300);
      }
    }

    const roulettes = [
      new Roulette("wheel-0", 0),
      new Roulette("wheel-1", 1)
    ];

    preloadImages();

    /**
     * Motion Curve:
     * - Accelerates over the first T_accel seconds
     * - Coasts at high velocity
     * - Decelerates smoothly during the final 1.0 second before stopping
     */
    function computeAngleAtTime(t, totalDuration) {
      const tAccel = 1.2;
      const tDecel = 1.0;
      const tCoast = totalDuration - tAccel - tDecel;
      const vMax = 18; // Radians per second (~3 revs/sec)

      // Acceleration phase
      if (t <= tAccel) {
        return 0.5 * (vMax / tAccel) * (t * t);
      }

      const distAccel = 0.5 * vMax * tAccel;

      // Cruising phase
      if (t <= tAccel + tCoast) {
        return distAccel + vMax * (t - tAccel);
      }

      // Deceleration phase (final 1.0s)
      const distCoast = vMax * tCoast;
      const tIntoDecel = t - (tAccel + tCoast);
      const decelProgress = tIntoDecel / tDecel; // 0 to 1

      // Integral of v(tau) = vMax * (1 - tau)^2
      const decelDistance = vMax * tDecel * (decelProgress - Math.pow(decelProgress, 2) + Math.pow(decelProgress, 3) / 3);

      return distAccel + distCoast + decelDistance;
    }

    function spinRoulettes() {
      const btn = document.getElementById("spinBtn");
      btn.disabled = true;

      roulettes.forEach(r => {
        r.reset();
        r.draw();
      });

      // Randomized duration between 7.0 and 9.0 seconds per roulette
      const durations = [
        7.0 + Math.random() * 2.0,
        7.0 + Math.random() * 2.0
      ];

      const initialAngles = [roulettes[0].angle, roulettes[1].angle];
      const startTime = performance.now();
      let completed = [false, false];

      function frame(now) {
        const elapsedSec = (now - startTime) / 1000;

        roulettes.forEach((r, idx) => {
          const duration = durations[idx];

          if (elapsedSec < duration) {
            const addedAngle = computeAngleAtTime(elapsedSec, duration);
            r.angle = initialAngles[idx] + addedAngle;
            r.draw();
          } else if (!completed[idx]) {
            completed[idx] = true;
            const finalAngle = computeAngleAtTime(duration, duration);
            r.angle = initialAngles[idx] + finalAngle;
            r.draw();

            // Select and reveal
            const winner = r.getWinningDog();
            r.collapseAndReveal(winner);
          }
        });

        if (!completed[0] || !completed[1]) {
          requestAnimationFrame(frame);
        } else {
          setTimeout(() => {
            btn.disabled = false;
          }, 1200);
        }
      }

      requestAnimationFrame(frame);
    }
  </script>
</body>
</html>
